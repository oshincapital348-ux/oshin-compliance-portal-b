# Copy this to Vercel → Project Settings → Environment Variables.
# Never commit a real .env file with actual secrets to git.

# --- Razorpay (instant automatic unlock, ~2% fee per transaction) ---
# From Razorpay dashboard → Settings → API Keys. Use TEST keys (rzp_test_...)
# while trying things out; switch to LIVE keys only once verified working.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- Free UPI QR path (manual admin approval) ---
UPI_ID=yourrealupi@bank
REPORT_FEE_RUPEES=499
PAYEE_NAME=Oshin Capital

# --- Shared ---
# Any long random string — used to sign access tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string

# The super-admin passcode. Pick something you won't forget and won't share.
ADMIN_CODE=replace-with-a-strong-passphrase

# Optional: where UPI payment claims get sent (e.g. a Formspree endpoint or
# your own webhook). Leave unset and claims will just show in Vercel logs.
NOTIFY_WEBHOOK_URL=
