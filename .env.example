# Copy this to Vercel → Project Settings → Environment Variables.
# Never commit a real .env file with actual secrets to git.

# --- Razorpay (instant automatic unlock, ~2% fee per transaction) ---
# From Razorpay dashboard → Settings → API Keys. Use TEST keys (rzp_test_...)
# while trying things out; switch to LIVE keys only once verified working.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- Free UPI QR path (manual admin approval) ---
UPI_ID=yourrealupi@bank
PAYEE_NAME=Oshin Capital

# --- Shared ---
# Any long random string — used to sign access tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string

# The super-admin passcode. Pick something you won't forget and won't share.
ADMIN_CODE=replace-with-a-strong-passphrase

# Optional: where UPI payment claims get sent (e.g. a Formspree endpoint or
# your own webhook). Leave unset and claims will just show in Vercel logs.
NOTIFY_WEBHOOK_URL=

# --- Auto-forward access links to customers by email (optional) ---
# Free at resend.com. When set, approving a UPI claim with an email contact
# automatically emails them the access link — no manual copy/paste needed.
# Without it, the admin panel still works, just shows the link to send by hand.
RESEND_API_KEY=
# Optional — defaults to Resend's shared test sender if unset. Set this once
# you verify your own domain on Resend, for better inbox deliverability.
RESEND_FROM_EMAIL=

# Where the "someone says they paid" alert email goes when a UPI claim is
# submitted. Defaults to oshincapital348@gmail.com if unset — set this if you
# want alerts to go somewhere else instead (needs RESEND_API_KEY set too).
ADMIN_ALERT_EMAIL=

# --- Admin activity tracking & notifications (optional but recommended) ---
# Free: Vercel dashboard → Storage → Create Database → Upstash Redis.
# It auto-fills one of these two pairs for you, depending on how it was
# connected (older direct integration vs newer Marketplace flow) — you only
# need whichever pair actually got filled in, not both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Tiered pricing based on project cost (optional — sensible defaults apply if unset) ---
# Format: "maxProjectCost:feeInRupees,maxProjectCost:feeInRupees,..."
# Only whoever has Vercel dashboard access (the super admin) can change this.
PRICING_TIERS=100000:99,200000:199,500000:299,1000000:499,2500000:799,5000000:1299,10000000:1999

# --- Customer help chatbot (optional, free) ---
# Get a free key at aistudio.google.com (Google account, no credit card
# needed to start). Free tiers have rate limits that can change over time —
# check current limits in AI Studio if the chat seems to stop responding
# during busy periods. Without this key, the "Need help?" chat button still
# shows but tells the customer it's not configured yet — nothing else on
# the site is affected.
GEMINI_API_KEY=
# Optional — defaults to a fast, free-tier-friendly Gemini Flash model.
# Verify the exact current model name in AI Studio when you get your key,
# in case the default here has since been retired/renamed.
GEMINI_MODEL=
